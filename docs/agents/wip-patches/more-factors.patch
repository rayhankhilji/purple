+  for (const k of NEW) { const [part, param] = k.split("."), s = parts.BY_ID[part].params[param]; assert.ok(s && Number.isInteger(+((s.base - s.min) / s.step).toFixed(9)), k); assert.equal(GEN.params[part][param], s.base); }
+});
